---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getResumeContent } from '@/lib/content';
import { personSchema, breadcrumbSchema } from '@/lib/seo';

const SITE_ORIGIN = 'https://steveackley.org';

const { summary } = await getResumeContent();

const jsonLd = [
  personSchema,
  breadcrumbSchema([
    { name: 'Home', url: SITE_ORIGIN },
    { name: 'About', url: `${SITE_ORIGIN}/about` },
  ]),
];
---

<PublicLayout
  title="About"
  description="Who Steve Ackley is: staff software engineer, .NET and AWS consultant, and builder of a small fleet of side products."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">About</h1>
    <div class="accent-bar mt-6"></div>

    <div class="mt-8 space-y-5 text-[var(--text-secondary)] leading-relaxed">
      <p>{summary}</p>
      <p>
        Outside the day job I run a small fleet of side products under Qavren Solutions LLC and write
        about what building them actually looks like — CI/CD failures included — on
        <a href="/blog" class="text-[var(--accent)] hover:underline">the blog</a>.
      </p>
      <p>
        The full work history, certifications, and tech stack live on the
        <a href="/resume" class="text-[var(--accent)] hover:underline">resume</a>. Code is on
        <a href="https://github.com/stevenfackley" rel="noopener noreferrer" class="text-[var(--accent)] hover:underline">GitHub</a>.
      </p>
      <p>
        Available for contract, consulting, and advisory work —
        <a href="/contact" class="text-[var(--accent)] hover:underline">get in touch</a>.
      </p>
    </div>
  </div>
</PublicLayout>
