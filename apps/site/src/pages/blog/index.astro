---
import PublicLayout from '@/layouts/PublicLayout.astro';
import PostList from '@/components/blog/PostList.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { db, posts as postsTable } from '@/db';
import { desc, count } from 'drizzle-orm';
import { pageExists, requestedPage } from '@/lib/pagination';
import { isPublic, withReadMinutes } from '@/lib/posts';
import type { PaginationInfo } from '@/types';

const SITE_ORIGIN = 'https://steveackley.org';

const PER_PAGE = 10;
const currentPage = requestedPage(Astro.url.searchParams.get('page'));

// Get total count of published posts
const [totalCountResult] = await db
  .select({ value: count() })
  .from(postsTable)
  .where(isPublic());

const totalItems = totalCountResult?.value || 0;
const totalPages = Math.ceil(totalItems / PER_PAGE);

// A page past the last one is not a page. Without this, ?page= with a large enough number
// reached the query below as an offset Postgres rejects, and the request failed with a 500.
if (!pageExists(currentPage, totalPages)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Get paginated posts
const rows = await db
  .select()
  .from(postsTable)
  .where(isPublic())
  .orderBy(desc(postsTable.createdAt))
  .limit(PER_PAGE)
  .offset((currentPage - 1) * PER_PAGE);

const posts = rows.map(withReadMinutes);

const pagination: PaginationInfo = {
  currentPage,
  totalPages,
  totalItems,
  itemsPerPage: PER_PAGE,
  hasPreviousPage: currentPage > 1,
  hasNextPage: currentPage < totalPages,
};

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog – Steve Ackley',
  description: 'Writing on .NET, AWS, software architecture, and engineering practices.',
  url: `${SITE_ORIGIN}/blog`,
  author: { '@type': 'Person', name: 'Steve Ackley', url: SITE_ORIGIN },
  ...(posts.length > 0 && {
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: posts.map((p, i) => ({
        '@type': 'ListItem',
        position: (currentPage - 1) * PER_PAGE + i + 1,
        url: `${SITE_ORIGIN}/blog/${p.slug}`,
        name: p.title,
      })),
    },
  }),
};
---

<PublicLayout
  title="Blog"
  description="Writing on .NET, AWS, software architecture, and engineering practices."
  jsonLd={blogJsonLd}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-12" data-reveal>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-[var(--accent-2)] mb-3">Writing</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight gradient-text pb-1">Blog</h1>
      <p class="mt-3 text-[var(--text-secondary)] text-lg">
        Thoughts on software, technology, and whatever else I find interesting.
      </p>
    </header>

    {posts.length > 0 ? (
      <>
        <PostList posts={posts} featureFirst={currentPage === 1} />
        {totalPages > 1 && <Pagination pagination={pagination} basePath="/blog" />}
      </>
    ) : (
      <div class="text-center py-20">
        <p class="text-[var(--text-secondary)]">No posts found. Check back later!</p>
      </div>
    )}
  </div>
</PublicLayout>
